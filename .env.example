# Export these variables in your hosting environment. This file is a reference,
# not automatically loaded by the application.
ADMIN_PASSWORD=replace-with-a-long-unique-password
PORT=3000
# Leave HOST unset on Hostinger; production listens on all interfaces.
# Trusted reverse proxy addresses; default is local loopback only
TRUST_PROXY=loopback
SITE_URL=https://www.tanzaniahugossafaris.com
DATA_DIR=data
# HTTPS endpoint for your email/CRM notification automation (optional)
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
